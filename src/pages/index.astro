---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { loadAndFormatCollection } from "../util/collection";

let projects: any[] = (await loadAndFormatCollection("projects", false)).sort(
    (a: any, b: any) => a.data.weight - b.data.weight,
);

let firstThreeProjects: any[] = projects.slice(0, 3);
---

<Layout>
    <div class="flex flex-col min-h-screen px-4 py-4">
        <div class="landing-content max-w-4xl mx-auto space-y-8 flex-1">
            <header class="space-y-6">
                <div class="sticky-header">
                    <div class="max-w-4xl mx-auto flex justify-between items-center">
                        <Header enableHomeLink={false} />
                    </div>
                </div>

                <div class="intro-box text-gray-300 leading-relaxed">
                    <p>Hi. I'm Gareth, a software developer.</p>
                    <p>
                        I have a games computing background with experience in
                        building scalable applications, APIs, modern web
                        frameworks, UI/UX and working with database
                        technologies.
                    </p>
                </div>
            </header>

            <section class="panel projects-panel">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-xl accent-text mb-4 font-bold">Projects</h2>
                    <a
                        href="/projects/"
                        class="projects-more-link accent-button text-sm px-4 py-1.5 rounded-full border bg-transparent hover:bg-transparent transition"
                    >
                        See more →
                    </a>
                </div>

                <div class="grid md:grid-cols-3 gap-4 projects-grid">
                    {
                        firstThreeProjects.map((project: any) => (
                            <ProjectCard project={project} />
                        ))
                    }
                </div>

            </section>

            <section class="panel proficiencies-panel">
                <h2 class="text-xl accent-text mb-4 font-bold">
                    Proficiencies
                </h2>

                <p class="text-sm text-gray-400 mb-6">
                    Here are some examples of technologies I'm experienced with:
                </p>

                <div class="proficiency-grid">
                    <article class="proficiency-group">
                        <h3>Languages</h3>
                        <ul>
                            <li>C#</li><li>C++</li><li>HTML</li><li>CSS</li>
                            <li>SCSS</li><li>Python</li><li>TypeScript</li><li>JavaScript</li>
                        </ul>
                    </article>
                    <article class="proficiency-group">
                        <h3>Frameworks</h3>
                        <ul>
                            <li>React</li><li>React Native</li><li>.NET</li>
                            <li>Bootstrap</li><li>Tailwind CSS</li><li>Astro</li>
                            <li>Material UI</li><li>Chakra UI</li><li>Django</li><li>Flask</li>
                        </ul>
                    </article>
                    <article class="proficiency-group">
                        <h3>Game Engines</h3>
                        <ul><li>Unity</li><li>Godot</li></ul>
                    </article>
                    <article class="proficiency-group">
                        <h3>Databases</h3>
                        <ul><li>MySQL</li><li>PostgreSQL</li><li>MongoDB</li></ul>
                    </article>
                    <article class="proficiency-group">
                        <h3>Editors</h3>
                        <ul><li>VS Code</li><li>Visual Studio</li></ul>
                    </article>
                    <article class="proficiency-group">
                        <h3>Platforms</h3>
                        <ul><li>Desktop</li><li>Web</li><li>Mobile</li></ul>
                    </article>
                    <article class="proficiency-group">
                        <h3>Tools &amp; Services</h3>
                        <ul>
                            <li>Git</li><li>Docker</li><li>AWS</li>
                            <li>Azure</li><li>Postman</li><li>Figma</li>
                        </ul>
                    </article>
                </div>
            </section>
        </div>
    </div>
</Layout>
