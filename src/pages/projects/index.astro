---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { loadAndFormatCollection } from "../../util/collection";

const projects: any[] = (await loadAndFormatCollection("projects", false)).sort(
    (a: any, b: any) => a.data.weight - b.data.weight,
);
---

<Layout title="Projects">
    <div class="min-h-screen px-4 py-4">
        <header class="sticky-header">
            <div class="max-w-4xl mx-auto flex justify-between items-center">
                <Header enable-home-link={true} />
            </div>
        </header>

        <main class="projects-index-content max-w-4xl mx-auto space-y-6 w-full">
            <header class="space-y-2">
                <h1 class="text-3xl font-semibold accent-text">Projects</h1>
                <p class="text-gray-400">
                    Here is a selection of projects I’ve worked on. You can
                    find the source code for each project on my GitHub.
                </p>
            </header>

            <section
                class="projects-list grid md:grid-cols-2 gap-4"
                aria-label="All projects"
            >
                {projects.map((project: any) => (
                    <ProjectCard project={project} />
                ))}
            </section>
        </main>
    </div>
</Layout>
