---
import { render } from 'astro:content';
import Layout from "../../../layouts/Layout.astro";
import Header from '../../../components/Header.astro';
import { loadAndFormatCollection } from "../../../util/collection";
import { truncate } from "../../../util/string";

export async function getStaticPaths() {
    const projects = await loadAndFormatCollection('projects', false);

    return projects
        .map((project: any) => {
            return {
                params: { slug: project.relativeURL },
                props: { project }
            };
        });
}

const { project } = Astro.props;
const { Content } = await render(project);

const projects: any[] = (await loadAndFormatCollection("projects", false)).sort(
    (a: any, b: any) => a.data.weight - b.data.weight,
);

let prevProject = null;
let nextProject = null;

for (let i = 0; i < projects.length; ++i) {
    if (projects[i].data.title == project.data.title) {
        if (i > 0) prevProject = projects[i - 1];
        if (i + 1 < projects.length) nextProject = projects[i + 1];
        break;
    }
}

if (prevProject != null) {
    prevProject.data.title = truncate(prevProject.data.title);
}

if (nextProject != null) {
    nextProject.data.title = truncate(nextProject.data.title);
}
---

<Layout>
    <header class="sticky-header">
        <div class="max-w-4xl mx-auto flex justify-between items-center">
            <Header enable-home-link={true} />
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-container">
            <h1 class="hero-title">{project.data.title}</h1>
            <p class="hero-subtitle">{project.data.summary}</p>
            <div class="hero-tags">
                {
                    project.data.tags.map((tag: string) => (
                        <span class="hero-tag">{tag}</span>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Content Section -->
    <main class="content-section">
        <!-- Info Badges -->
        <div class="info-badges">
            <span class="info-badge">
                <span class="label">Type:</span> <span class="value">{project.data.type}</span>
            </span>
            <span class="info-badge">
                <span class="label">Link:</span>
                    <a href={project.data.url} target="_blank">
                    github
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                </a>
            </span>
        </div>

        <Content />

        <!-- Navigation -->
        <nav class="project-nav">
            <div>
                {
                    prevProject != null && (
                        <a href={prevProject.absoluteURL} class="nav-link">
                            <span>‹ Previous project</span>
                            {prevProject.data.title}
                        </a>
                    )
                }
            </div>
            <div class="text-right">
                {
                    nextProject != null && (
                        <a href={nextProject.absoluteURL} class="nav-link">
                            <span>Next project ›</span>
                            {nextProject.data.title}
                        </a>
                    )
                }
            </div>
        </nav>
    </main>
</Layout>
