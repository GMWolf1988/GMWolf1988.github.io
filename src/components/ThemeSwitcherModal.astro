---
---

<div id="themeModal" class="theme-modal-overlay hidden">
    <div class="theme-modal-panel">
	<h3 class="text-lg text-orange-300 mb-4">Theme Settings</h3>
	<div class="theme-options space-y-3">
	    <label class="theme-option">
		<input
		    type="radio"
		    name="theme"
		    value="system"
		    class="theme-radio"
		/>
		<span class="theme-option-label">
		    <svg
			class="w-5 h-5"
			fill="none"
			stroke="currentColor"
			viewBox="0 0 24 24"
		    >
			<path
			    stroke-linecap="round"
			    stroke-linejoin="round"
			    stroke-width="2"
			    d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
			></path>
		    </svg>
		    <span>System</span>
		</span>
	    </label>
	    <label class="theme-option">
		<input
		    type="radio"
		    name="theme"
		    value="light"
		    class="theme-radio"
		/>
		<span class="theme-option-label">
		    <svg
			class="w-5 h-5"
			fill="none"
			stroke="currentColor"
			viewBox="0 0 24 24"
		    >
			<path
			    stroke-linecap="round"
			    stroke-linejoin="round"
			    stroke-width="2"
			    d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
			></path>
		    </svg>
		    <span>Light</span>
		</span>
	    </label>
	    <label class="theme-option">
		<input
		    type="radio"
		    name="theme"
		    value="dark"
		    class="theme-radio"
		/>
		<span class="theme-option-label">
		    <svg
			class="w-5 h-5"
			fill="none"
			stroke="currentColor"
			viewBox="0 0 24 24"
		    >
			<path
			    stroke-linecap="round"
			    stroke-linejoin="round"
			    stroke-width="2"
			    d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
			></path>
		    </svg>
		    <span>Dark</span>
		</span>
	    </label>
	</div>
	<div class="flex justify-end gap-3 mt-6">
	    <button
		id="themeCancelBtn"
		class="theme-modal-btn theme-modal-btn-cancel"
		>Cancel</button
	    >
	    <button
		id="themeSaveBtn"
		class="theme-modal-btn theme-modal-btn-save"
		>Save</button
	    >
	</div>
    </div>
</div>
