---
import Brand from "./Brand.astro"

interface Props {
    enableHomeLink?: boolean;
}

const { enableHomeLink = true } = Astro.props;
---

<div class="flex grow justify-between items-start">
    <div class="flex grow">
	<div>
	    { enableHomeLink ? <a href="/"><Brand /></a> : <Brand /> }
	</div>
    </div>

</div>
